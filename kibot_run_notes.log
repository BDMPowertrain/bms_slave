  type: position
  category: 'Manufacturing/Assembly'
  dir: 'Manufacturing/Assembly'
  options:
    format: 'CSV'
    only_smd: false
    include_virtual: false
    output: '%f-CPL%I%v.%x'
    separate_files_for_front_and_back: false

