            color: '#000000'
          - layer: B.Cu
            color: '#F2F2F2'
          - layer: B.Mask
            color: '#E2E2E2'
          - layer: B.Paste
            color: '#E2E2E2'
          - layer: B.Silkscreen
            color: '#DBDBDB'
          - layer: B.Fab
            plot_footprint_refs: false
            plot_footprint_values: false
            color: '#818181'
          - layer: B.Dimensions
            color: '#000000'

      - scaling: 1
        title: 'Fabrication'
