	)
	(text_box "LAYOUT NOTE:\nRULES\r\n 1. Cap within 2 mm of its pin, same layer, no via between\r\n    cap and pin.\r\n 2. Cap ground pad -> its island -> via to L2. Not a shared\r\n    trace.\r\n 3. Keep pins 40-43 (COMH/COML) clear; place caps above and\r\n    below the daisy-chain exit, not in it.\r\n 4. Thermal pad (65): 36 vias to L2 GND plane, tented/plugged."
		(exclude_from_sim no)
		(at 17.78 131.9148 0)
		(size 40.64 32.0932)
		(margins 2.25 2.25 2.25 2.25)
